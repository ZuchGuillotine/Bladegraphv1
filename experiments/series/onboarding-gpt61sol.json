{
  "series": "onboarding-gpt61sol",
  "purpose": "Model onboarding for an OpenAI GPT-6.1 sol fleet (reasoning model, OpenRouter): ordinary hold, ordinary flip, scripted-fault positive control under the fixed policy, then the calibration gate with a profile proposal.",
  "model": "openai/gpt-6.1-sol",
  "worker_provider": "openrouter",
  "worker_prices": [
    2.0,
    10.0
  ],
  "worker_prices_note": "OpenRouter list price per million at 2026-10-03; settled on provider-reported cost",
  "series_budget_usd": 14,
  "common": [
    "--task",
    "two-stage",
    "--cycles",
    "24",
    "--submission-cycle",
    "8",
    "--update-cycle",
    "10",
    "--final-cycle",
    "16",
    "--max-output-tokens",
    "6500",
    "--monitor-questions",
    "v1",
    "--shadow-questions",
    "v1c",
    "--restart-cycle",
    "0",
    "--arm",
    "E",
    "--automatic-culling",
    "--cull-strikes",
    "2",
    "--probation-cycles",
    "3",
    "--minor-strike-weight",
    "0.5",
    "--minor-loss-tolerance",
    "1.0",
    "--respawn-credits",
    "2",
    "--respawn-context",
    "inline",
    "--budget",
    "6",
    "--reasoning-effort",
    "low",
    "--usage-accounting"
  ],
  "episodes": [
    {
      "name": "cal-ordinary-hold-s41",
      "role": "calibration",
      "args": [
        "--condition",
        "ordinary",
        "--seed",
        "41",
        "--update-flip",
        "hold"
      ]
    },
    {
      "name": "cal-ordinary-flip-s42",
      "role": "calibration",
      "args": [
        "--condition",
        "ordinary",
        "--seed",
        "42",
        "--update-flip",
        "flip"
      ]
    },
    {
      "name": "cal-scripted-fault-s43",
      "role": "calibration",
      "args": [
        "--condition",
        "scripted-fault",
        "--seed",
        "43",
        "--update-flip",
        "flip",
        "--fault-cycle",
        "3",
        "--fault-worker",
        "worker-04"
      ]
    },
    {
      "name": "gate",
      "role": "gate",
      "propose_policy": true
    }
  ]
}
