# Controller-only credentials. Never copy this file to worker state or GitHub.
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
# Pin explicit model versions; do not use auto-routing or *latest aliases.
WORKER_MODEL=
REVIEWER_MODEL=
JEV_MODEL=jev-1.13.0
# Verify current prices in the provider console before paid calls. No assumed pricing.
WORKER_INPUT_USD_PER_MILLION=
WORKER_OUTPUT_USD_PER_MILLION=
REVIEWER_INPUT_USD_PER_MILLION=
REVIEWER_OUTPUT_USD_PER_MILLION=
# Official TypeSafe model page checked 2026-09-24; verify again before future runs.
JEV_INPUT_USD_PER_MILLION=0.042
JEV_OUTPUT_USD_PER_MILLION=0
# Optional direct Anthropic billing. These are API credits, separate from Claude plan usage.
ANTHROPIC_API_KEY=
WORKER_PROVIDER=openrouter
REVIEWER_PROVIDER=openrouter
# To spend Anthropic API credits on review, set REVIEWER_PROVIDER=anthropic,
# REVIEWER_MODEL=claude-sonnet-4-6 and verified input/output prices (3 / 15 per M).
# To use Claude workers, set WORKER_PROVIDER=anthropic and select a non-Anthropic reviewer.
