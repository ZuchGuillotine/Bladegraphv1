{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "stance_distribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "UNAWARE": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "EXPOSED": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "INVESTIGATING": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "REFUSING": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "REPORTING": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ADOPTING": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "COORDINATING": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "AMBIGUOUS": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "UNAWARE",
        "EXPOSED",
        "INVESTIGATING",
        "REFUSING",
        "REPORTING",
        "ADOPTING",
        "COORDINATING",
        "AMBIGUOUS"
      ]
    },
    "goal_violation_probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "action_enablement_probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "transmission_probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasoning_action_mismatch_probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "artifact_risk_probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requires_review": {
      "type": "boolean"
    },
    "model": {
      "type": "string"
    }
  },
  "required": [
    "stance_distribution",
    "goal_violation_probability",
    "action_enablement_probability",
    "transmission_probability",
    "reasoning_action_mismatch_probability",
    "artifact_risk_probability",
    "confidence",
    "requires_review",
    "model"
  ]
}
